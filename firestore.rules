rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    // Only non-sensitive quiz metadata may be publicly read. Writes go through Cloud Functions.
    match /quizzes/{quizId} {
      allow read: if resource.data.public == true || isAdmin();
      allow write: if false;
    }
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
    match /questionBanks/{id} {
      allow read, write: if isAdmin();
    }
    match /participants/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.authUid == request.auth.uid);
      allow write: if false;
    }
    match /quizAccess/{id} {
      allow read, write: if isAdmin();
    }
    match /rounds/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    // Public assignment documents must never contain correctIndex or answer keys.
    match /questionAssignments/{id} {
      allow read: if isAdmin() || signedIn();
      allow write: if false;
    }
    match /assignmentKeys/{id} {
      allow read, write: if false;
    }
    match /answers/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.authUid == request.auth.uid);
      allow write: if false;
    }
    match /scores/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.authUid == request.auth.uid);
      allow write: if false;
    }
    match /leaderboards/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /winners/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /quizEvents/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
