rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    // Public clients may read only safe quiz metadata. Never expose answer keys.
    match /quizzes/{quizId} {
      allow read: if resource.data.public == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false; // provision admins with trusted Admin SDK only
    }
    match /questionBanks/{id} {
      allow read, write: if isAdmin();
    }
    match /participants/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.authUid == request.auth.uid);
      allow write: if false; // use validated Cloud Functions
    }
    match /rounds/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /questionAssignments/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.authUid == request.auth.uid);
      allow write: if false;
    }
    match /answers/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.authUid == request.auth.uid);
      allow write: if false; // answer submission goes through server-side function
    }
    match /scores/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.authUid == request.auth.uid);
      allow write: if false;
    }
    match /leaderboards/{id} {
      allow read: if true; // only publish safe display fields here
      allow write: if false;
    }
    match /winners/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /quizEvents/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}